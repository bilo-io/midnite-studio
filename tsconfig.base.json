{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@midnite/studio-shared": ["./packages/shared/src/index.ts"],
      "@midnite/studio-shared/*": ["./packages/shared/src/*"],
      "@midnite/studio-git-engine": ["./packages/git-engine/src/index.ts"],
      "@midnite/studio-git-engine/*": ["./packages/git-engine/src/*"],
      "@midnite/studio-db-engine": ["./packages/db-engine/src/index.ts"],
      "@midnite/studio-db-engine/*": ["./packages/db-engine/src/*"],
      "@midnite/studio-knowledge": ["./packages/knowledge/src/index.ts"],
      "@midnite/studio-knowledge/*": ["./packages/knowledge/src/*"],
      "@midnite/studio-runtime": ["./packages/runtime/src/index.ts"],
      "@midnite/studio-runtime/broker/*": ["./packages/runtime/src/broker/*"],
      "@midnite/studio-runtime/app-main/*": ["./packages/runtime/src/app-main/*"],
      "@midnite/studio-feature-optimizer/main": ["./packages/features/optimizer/main/index.ts"],
      "@midnite/studio-feature-monitor/main": ["./packages/features/monitor/main/index.ts"],
      "@midnite/studio-feature-vault/main": ["./packages/features/vault/main/index.ts"],
      "@midnite/studio-feature-notes/main": ["./packages/features/notes/main/index.ts"],
      "@midnite/studio-feature-finance/main": ["./packages/features/finance/main/index.ts"],
      "@midnite/studio-feature-tests/main": ["./packages/features/tests/main/index.ts"],
      "@midnite/studio-feature-forge/main": ["./packages/features/forge/main/index.ts"],
      "@midnite/studio-feature-api-client/main": ["./packages/features/api-client/main/index.ts"],
      "@midnite/studio-feature-database/main": ["./packages/features/database/main/index.ts"],
      "@midnite/studio-feature-api-client/script-runner-worker": ["./packages/features/api-client/main/script-runner-worker.ts"],
      "@midnite/studio-feature-media-core/main": ["./packages/features/media-core/main/index.ts"],
      "@midnite/studio-feature-media-docs/main": ["./packages/features/media-docs/main/index.ts"],
      "@midnite/studio-feature-media-images/main": ["./packages/features/media-images/main/index.ts"],
      "@midnite/studio-feature-models/main": ["./packages/features/models/main/index.ts"],
      "@midnite/studio-feature-chats/main": ["./packages/features/chats/main/index.ts"],
      "@midnite/studio-feature-councils/main": ["./packages/features/councils/main/index.ts"],
      "@midnite/studio-feature-media-video/main": ["./packages/features/media-video/main/index.ts"],
      "@midnite/studio-feature-media-audio/manifest": ["./packages/features/media-audio/manifest.ts"],
      "@midnite/studio-feature-media-audio/main": ["./packages/features/media-audio/main/index.ts"],
      "@midnite/studio-feature-media-audio/music-worker": ["./packages/features/media-audio/main/musicgen/worker-entry.ts"],
      "@midnite/studio-feature-media-map/main": ["./packages/features/media-map/main/index.ts"],
      "@midnite/studio-feature-media-map/map-capture-worker": ["./packages/features/media-map/main/map/worker-entry.ts"],
      "@midnite/studio-feature-media-terrain/main": ["./packages/features/media-terrain/main/index.ts"],
      "@midnite/studio-feature-media-terrain/terrain-worker": ["./packages/features/media-terrain/main/terrain/worker-entry.ts"],
      "@midnite/studio-feature-media-sprite/main": ["./packages/features/media-sprite/main/index.ts"],
      "@midnite/studio-feature-media-game/main": ["./packages/features/media-game/main/index.ts"],
      "@midnite/studio-feature-workflows/main": ["./packages/features/workflows/main/index.ts"],
      "@midnite/studio-feature-mcp-tools/main": ["./packages/features/mcp-tools/main/index.ts"]
    }
  }
}
