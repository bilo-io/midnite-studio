# @bilo-io/* (the midnite-ui design system: @bilo-io/ui + @bilo-io/shell) are
# published to GitHub Packages, not npmjs. GH Packages requires an Authorization
# header even for PUBLIC packages, so a token is mandatory for `pnpm install` —
# locally AND in CI.
#
#   export GITHUB_PACKAGES_TOKEN=ghp_...   # classic PAT, `read:packages` scope
#   # or, if you use the gh CLI:
#   gh auth refresh -s read:packages
#   export GITHUB_PACKAGES_TOKEN=$(gh auth token)
#
# Env indirection only — never commit a literal token here.
@bilo-io:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_PACKAGES_TOKEN}

# Native-module hygiene (node-pty). pnpm's side-effects cache shares native build
# output through the global store via hardlinks; the desktop app electron-rebuilds
# node-pty for Electron's ABI, and a shared artifact would poison every other
# checkout on the machine. Copy instead of linking so builds stay per-checkout.
side-effects-cache=false
package-import-method=clone-or-copy
