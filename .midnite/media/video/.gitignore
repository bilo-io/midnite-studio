# video-editor/public/ is a generated mirror of assets/ + every project's input/
# (single tracked home per binary) — recreate with `npm run assets`
video-editor/public/

# Rendered iterations and verification stills are reproducible from the source
# of truth; the tracked record of each cut is each project's output/CHANGELOG.md.
# Project ids nest (projects/<brand>/<category>/<NNN-name>/), so the pattern has
# to match an output/ at any depth rather than exactly one level down.
projects/**/output/*
!projects/**/output/CHANGELOG.md
templates/**/output/*
!templates/**/output/CHANGELOG.md
