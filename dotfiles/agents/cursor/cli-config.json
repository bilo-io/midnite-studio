{
  "permissions": {
    "allow": [
      "Shell(cd)",
      "Shell(command)",
      "Shell(echo)",
      "Shell(eval)",
      "Shell(find)",
      "Shell(gh)",
      "Shell(git -C)",
      "Shell(git branch)",
      "Shell(git fetch)",
      "Shell(git log)",
      "Shell(git worktree)",
      "Shell(graphify)",
      "Shell(head)",
      "Shell(ls)",
      "Shell(pnpm install)",
      "Shell(printf)",
      "Shell(proto)",
      "Shell(pwd)",
      "Shell(readlink)",
      "Shell(rg)",
      "Shell(sleep)",
      "Shell(source)",
      "Shell(true)",
      "Shell(wc)",
      "Shell(which)"
    ],
    "deny": []
  },
  "version": 1,
  "editor": {
    "vimMode": false
  },
  "display": {
    "showLineNumbers": false,
    "showThinkingBlocks": false,
    "showStatusIndicators": false,
    "showStatusLineRunningTime": false,
    "mode": "zen"
  },
  "notifications": true,
  "hints": true,
  "modelSlashCommands": true,
  "rewind": true,
  "model": {
    "modelId": "auto-smart",
    "displayModelId": "auto-smart",
    "displayName": "Auto Balance",
    "displayNameShort": "Auto Balance",
    "aliases": [],
    "maxMode": false
  },
  "hasChangedDefaultModel": true,
  "modelParameters": {
    "auto-smart": [
      {
        "id": "optimize_for",
        "value": "balanced"
      }
    ],
    "default": []
  },
  "selectedModel": {
    "modelId": "auto-smart",
    "parameters": [
      {
        "id": "optimize_for",
        "value": "balanced"
      }
    ]
  },
  "modelSelectionHistory": [
    "auto-smart",
    "default"
  ],
  "exploreSubagentModel": "default",
  "network": {
    "useHttp1ForAgent": false
  },
  "approvalMode": "allowlist",
  "autoAcceptWebSearch": false,
  "sandbox": {
    "mode": "disabled",
    "networkAccess": "user_config_with_defaults"
  },
  "runEverythingSettingsPromptStreak": 1,
  "attribution": {
    "attributeCommitsToAgent": false,
    "attributePRsToAgent": false
  }
}
