# Git worktrees: parallel-agent checkouts live in the repo-root .worktrees/ dir
.worktrees/

# Claude Code: machine-local settings + agent worktrees (never committed)
.claude/settings.local.json
.claude/worktrees/

# Scratch output from scripts/smoke.ts and friends
tmp/

# Playwright browser-test artefacts (packages/app/e2e).
test-results/
playwright-report/

# Phase 82 Theme D: the pixel-diff layer's baselines are Linux-only by design
# (playwright.visual.config.ts's snapshotPathTemplate carries {platform}, and
# CI regenerates/asserts only through the official Linux Playwright image —
# see that config's own header comment). A baseline captured by running
# `moon run app:visual` directly on a macOS or Windows dev machine writes a
# `-darwin.png`/`-win32.png` file that CI can never produce or compare
# against, so it must never reach a commit; only `-linux.png` files are
# tracked under packages/app/e2e/visual/__screenshots__/.
packages/app/e2e/visual/__screenshots__/**/*-darwin.png
packages/app/e2e/visual/__screenshots__/**/*-win32.png

# Graphify knowledge graph artefacts
graphify-out/

# Local API/DB test fixtures generated against a running gateway — a snapshot of
# ~/.midnite/midnite.db plus a Postman v2.1 export of the gateway's 324 routes.
# Machine-local scratch for exercising the Database and API Client explorers;
# regenerate rather than commit (the .db alone is >5 MB).
/midnite-snapshot.db
/midnite.postman_collection.json
/*.postman_environment.json
/postman_environments.json
/gateway-routes.json

# API Client (Phase 66 Theme G): a convenience for developing the app against
# its own repo only — collections this repo's own `.midnite/api/` might pick up
# while dogfooding the client never need to be committed. The rule that
# actually protects a *user's* repo ships in Phase 70 Theme A, which writes
# `.midnite/api/.gitignore` into the repository the app is opened on.
.midnite/api/**/*.local.json
.aider*
