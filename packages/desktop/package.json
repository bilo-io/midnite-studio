{
  "name": "@midnite/studio-desktop",
  "version": "0.0.1",
  "private": true,
  "description": "Electron main + preload: owns git (via git-engine) and node-pty, exposes typed IPC.",
  "main": "dist/bundle/main.js",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node scripts/bundle.mjs && node scripts/start-electron.mjs",
    "bundle": "node scripts/bundle.mjs",
    "dist": "node scripts/bundle.mjs && electron-builder --mac --config electron-builder.yml"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.5.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^11.8.1",
    "dugite": "^2.7.1",
    "electron-updater": "^6.3.9",
    "kokoro-js": "^1.2.1",
    "node-pty": "^1.0.0",
    "sherpa-onnx-darwin-arm64": "^1.13.7",
    "sherpa-onnx-node": "^1.13.7",
    "unbzip2-stream": "^1.4.3",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@electron/rebuild": "^3.7.0",
    "@midnite/studio-app": "workspace:*",
    "@midnite/studio-db-engine": "workspace:*",
    "@midnite/studio-git-engine": "workspace:*",
    "@midnite/studio-shared": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/unbzip2-stream": "^1.4.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
