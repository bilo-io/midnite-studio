#!/bin/sh
# Deprecated alias for `midnite` (kept for one release, see
# Settings ▸ CLI). The CLI was renamed `midnite-studio` -> `midnite`;
# this wrapper forwards every argument to the real script beside it and says
# so on stderr when a person is watching. Scripts and pipes stay quiet.
set -e

candidate="$0"
while [ -L "$candidate" ]; do
  link=$(readlink "$candidate")
  case "$link" in
    /*) candidate="$link" ;;
    *) candidate="$(dirname "$candidate")/$link" ;;
  esac
done
SELF_DIR=$(cd "$(dirname "$candidate")" && pwd)

if [ -t 2 ]; then
  echo "note: 'midnite-studio' is deprecated and will be removed in the next release; use 'midnite'." >&2
fi
exec "$SELF_DIR/midnite" "$@"
