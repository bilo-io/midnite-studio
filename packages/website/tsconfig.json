{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    // Vite owns the build, and `composite` (inherited from the base) requires
    // emit. Nothing project-references this package, so turn all three off —
    // the same shape packages/app uses.
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "vite.config.ts", "vitest.config.ts", "tailwind.config.ts"],
  "exclude": ["dist", "node_modules"]
}
