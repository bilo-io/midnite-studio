{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    // Vite owns the build; `composite` (inherited from the base) requires emit,
    // so it's off here. Nothing references this project.
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "vite.config.ts", "vitest.config.ts", "tailwind.config.ts"],
  "exclude": ["dist", "node_modules"]
}
