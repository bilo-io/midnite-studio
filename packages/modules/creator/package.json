{
  "name": "@midnite/studio-module-creator",
  "version": "0.0.6",
  "private": true,
  "description": "The Creator module (Phase 124 Theme C): Docs, Images, Video and Audio over media-core (and Slides as a doc deck), mountable by any host.",
  "sideEffects": false,
  "exports": {
    "./renderer": "./renderer/index.ts",
    "./manifest": "./manifest.ts",
    "./main": {
      "types": "./dist/main/index.d.ts",
      "default": "./dist/main/index.js"
    },
    "./bridge": {
      "types": "./dist/main/bridge.d.ts",
      "default": "./dist/main/bridge.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.main.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@midnite/studio-feature-media-audio": "workspace:*",
    "@midnite/studio-feature-media-core": "workspace:*",
    "@midnite/studio-feature-media-docs": "workspace:*",
    "@midnite/studio-feature-media-images": "workspace:*",
    "@midnite/studio-feature-media-video": "workspace:*",
    "@midnite/studio-feature-report": "workspace:*",
    "@midnite/studio-feature-slides": "workspace:*",
    "@midnite/studio-frame": "workspace:*",
    "@midnite/studio-runtime": "workspace:*",
    "@midnite/studio-shared": "workspace:*",
    "@tanstack/react-query": "^5.62.0",
    "react-icons": "^5.7.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "^4.0.0"
  }
}
