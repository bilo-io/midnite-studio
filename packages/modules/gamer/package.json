{
  "name": "@midnite/studio-module-gamer",
  "version": "0.0.0",
  "private": true,
  "description": "The gamer module (Phase 124 Theme E): the Gamer host's own features, composed as one module its app mounts as a nav group.",
  "sideEffects": false,
  "exports": {
    "./renderer": "./renderer/index.ts",
    "./bridge": "./main/bridge.ts",
    "./main": {
      "types": "./dist/main/index.d.ts",
      "default": "./dist/main/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.main.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@bilo-io/ui": "0.2.0",
    "@midnite/studio-feature-media-core": "workspace:*",
    "@midnite/studio-feature-media-game": "workspace:*",
    "@midnite/studio-feature-media-images": "workspace:*",
    "@midnite/studio-feature-media-map": "workspace:*",
    "@midnite/studio-feature-media-model": "workspace:*",
    "@midnite/studio-feature-media-sprite": "workspace:*",
    "@midnite/studio-feature-media-terrain": "workspace:*",
    "@midnite/studio-feature-models": "workspace:*",
    "@midnite/studio-feature-report": "workspace:*",
    "@midnite/studio-frame": "workspace:*",
    "@midnite/studio-git-engine": "workspace:*",
    "@midnite/studio-runtime": "workspace:*",
    "@midnite/studio-shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tanstack/react-query": "^5.62.0",
    "react-icons": "^5.7.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.1",
    "zustand": "^5.0.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "^4.0.0"
  }
}
