{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Source-only: each app's Vite build compiles this package, so nothing
    // here emits and nothing references this project.
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["vite/client"],
    "paths": {
      // Source, not dist — the same resolution packages/app uses, so the frame
      // and the app it is compiled into typecheck against one contract.
      "@midnite/studio-shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["src/**/*", "vitest.config.ts"],
  "exclude": ["node_modules"]
}
