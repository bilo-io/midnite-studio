{
  "name": "@midnite/studio-git-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Pure Node/TS git layer \u2014 dugite exec, NUL-delimited parsers, commands, lane layout, watcher. No electron imports.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@midnite/studio-shared": "workspace:*",
    "dugite": "^2.7.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4",
    "tsx": "^4.19.2"
  }
}
