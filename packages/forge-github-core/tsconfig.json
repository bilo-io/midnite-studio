{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    // CommonJS for the same reason as shared: forge's main half (module: commonjs) reaches this through
    // a project reference, and desktop's esbuild bundle inlines it. The mobile app and vitest alias the
    // package to its source (src/index.ts), as they do for shared.
    "module": "commonjs",
    "moduleResolution": "node",
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"],
  "references": [{ "path": "../shared" }]
}
