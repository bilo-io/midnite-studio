{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    // CommonJS for the same reason as shared, git-engine and db-engine: the
    // Electron main process require()s the built engine, and the worker_threads
    // entry point (layout-worker.ts) needs a plain requirable file too.
    "module": "commonjs",
    "moduleResolution": "node",
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"],
  "references": [{ "path": "../shared" }]
}
