{
  "name": "@midnite/studio-feature-report",
  "version": "0.0.5",
  "private": true,
  "description": "Report an Issue as a feature: the dialog (renderer), the issue filing, gh status, diagnostics bundle and crash-report channels (main), and the preload bridge helper. Placed in the frame: every midnite app composes it.",
  "sideEffects": false,
  "exports": {
    "./renderer": "./renderer/index.ts",
    "./bridge": "./bridge.ts",
    "./main": {
      "types": "./dist/main/index.d.ts",
      "default": "./dist/main/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.main.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@bilo-io/ui": "0.1.0",
    "@midnite/studio-frame": "workspace:*",
    "@midnite/studio-runtime": "workspace:*",
    "@midnite/studio-shared": "workspace:*",
    "react-icons": "^5.7.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "^3.2.4"
  }
}
