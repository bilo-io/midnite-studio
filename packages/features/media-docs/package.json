{
  "name": "@midnite/studio-feature-media-docs",
  "version": "0.0.5",
  "private": true,
  "description": "Media ▸ Docs as a feature (Phase 113 Theme Q): the markdown doc editor, its explorer, AI-thread model and exports — Creator first, composed through media-core’s tab registry.",
  "sideEffects": false,
  "exports": {
    "./renderer": "./renderer/index.ts",
    "./renderer/testing": "./renderer/testing.ts",
