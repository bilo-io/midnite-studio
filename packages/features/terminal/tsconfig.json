{
  // The renderer half and the manifest — compiled from source by the app that
  // composes them (Vite), so this config only typechecks. The main half has its own config
  // (tsconfig.main.json): it is CommonJS for Electron main. The pty service stays in packages/desktop.
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["vite/client"],
    "paths": {
      "@midnite/studio-shared": ["../../shared/src/index.ts"],
      // The main half's import, for any tool that reads this (nearest) tsconfig's paths — esbuild does,
      // when desktop's bundle inlines main/index.ts.
      "@midnite/studio-runtime": ["../../runtime/src/index.ts"]
    }
  },
  "include": ["renderer/**/*", "manifest.ts", "manifest.test.ts", "vitest.config.ts", "vitest-setup.ts"],
  "exclude": ["node_modules", "dist"]
}
