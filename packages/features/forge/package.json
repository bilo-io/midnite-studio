{
  "name": "@midnite/studio-feature-forge",
  "version": "0.0.5",
  "private": true,
  "description": "The forge feature (Phase 113 Theme O): the forge providers, account registry, poller and handlers in main; the forge status vocabulary, forge queries, Reviews and Actions in the renderer. Coder's forge layer — one package for three placement folders (forge, reviews, actions).",
  "sideEffects": false,
  "exports": {
    "./renderer": "./renderer/index.ts",
    "./renderer/testing": "./renderer/testing.ts",
    "./main": {
      "types": "./dist/main/index.d.ts",
      "default": "./dist/main/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.main.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@bilo-io/ui": "0.1.0",
    "@midnite/studio-frame": "workspace:*",
    "@midnite/studio-git-engine": "workspace:*",
    "@midnite/studio-runtime": "workspace:*",
    "@midnite/studio-shared": "workspace:*",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-virtual": "^3.11.2",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^3.23.8",
    "zustand": "^5.0.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "^4.0.0"
  }
}
