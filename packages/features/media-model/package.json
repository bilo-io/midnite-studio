{
  "name": "@midnite/studio-feature-media-model",
  "version": "0.0.1",
  "private": true,
  "description": "Media ▸ Models as a feature (Phase 113 Theme S): the 3D editor tab composed through media-core's registry by Gamer and Studio.",
  "sideEffects": false,
  "exports": {
    "./manifest": "./manifest.ts",
    "./renderer": "./renderer/index.ts",
    "./events": "./renderer/events.ts",
    "./kernel": "./renderer/kernel.ts",
    "./render-job": "./renderer/render-job.ts",
    "./sf3d-worker": {
      "types": "./dist/main/model/sf3d/worker-entry.d.ts",
      "default": "./dist/main/model/sf3d/worker-entry.js"
    },
    "./main": {
      "types": "./dist/main/index.d.ts",
      "default": "./dist/main/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.main.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@midnite/studio-frame": "workspace:*",
    "@midnite/studio-git-engine": "workspace:*",
    "@midnite/studio-runtime": "workspace:*",
    "@midnite/studio-shared": "workspace:*",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9",
    "react-icons": "^5.7.0",
    "three": "^0.186.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.1",
    "zustand": "^5.0.2"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.62.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.62.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "^3.2.4"
  }
}
