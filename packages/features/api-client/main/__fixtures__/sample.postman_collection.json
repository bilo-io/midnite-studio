{
  "info": {
    "_postman_id": "6a4f6b6e-6c1f-4a3b-9e2d-2f5a7c9b1234",
    "name": "Sample API",
    "description": "A small, hand-built Postman v2.1 collection used only by collection-io.test.ts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Get status",
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "b3f1c9d0-0a1a-4c9e-8b1a-1a2b3c4d5e6f",
                "exec": ["pm.test('status is 200', function () {", "  pm.response.to.have.status(200);", "});"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Create widget",
      "event": [],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"widget\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/widgets",
          "host": ["{{baseUrl}}"],
          "path": ["widgets"]
        }
      },
      "response": []
    },
    {
      "name": "Delete widget",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/widgets/:id",
          "host": ["{{baseUrl}}"],
          "path": ["widgets", ":id"],
          "variable": [{ "key": "id", "value": "1" }]
        }
      },
      "response": []
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "https://api.example.test" }
  ],
  "protocolProfileBehavior": {
    "disableBodyPruning": true
  }
}
