{
  "name": "@midnite/studio-feature-capture",
  "version": "0.0.6",
  "private": true,
  "description": "Capture as a feature (Phase 113 Theme K): screen, window and region screenshots, screen recordings, the global capture shortcut, an opt-in clipboard history and Send to… — every capture taken on a user action and kept on this machine.",
  "sideEffects": false,
  "exports": {
    "./renderer": "./renderer/index.ts",
    "./overlay-page": "./renderer/overlay/entry.ts",
    "./overlay-page.html": "./renderer/overlay/capture-overlay.html",
    "./main": {
      "types": "./dist/main/index.d.ts",
      "default": "./dist/main/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.main.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@midnite/studio-frame": "workspace:*",
    "@midnite/studio-runtime": "workspace:*",
    "@midnite/studio-shared": "workspace:*",
    "react-icons": "^5.7.0",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "^4.0.0"
  }
}
