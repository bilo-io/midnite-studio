{
  "name": "@midnite/studio-feature-companion",
  "version": "0.0.5",
  "private": true,
  "description": "The companion as a feature (Phase 123 Theme F): the orb, panel, thread, voice and zen stage (renderer) behind a CompanionHost port, and the snapshot, digest, ask, STT and TTS services (main) behind CompanionMainServices. Placed in the frame.",
  "sideEffects": false,
  "exports": {
    "./renderer": "./renderer/index.ts",
    "./main": {
      "types": "./dist/main/index.d.ts",
      "default": "./dist/main/index.js"
    },
    "./main/*": {
      "types": "./dist/main/*.d.ts",
      "default": "./dist/main/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.main.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@midnite/studio-frame": "workspace:*",
    "@midnite/studio-runtime": "workspace:*",
    "@midnite/studio-shared": "workspace:*",
    "@tanstack/react-virtual": "^3.11.2",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "unbzip2-stream": "^1.4.3",
    "zod": "^3.23.8",
    "zustand": "^5.0.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "^3.5.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/unbzip2-stream": "^1.4.3",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "^4.0.0"
  }
}
