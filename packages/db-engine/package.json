{
  "name": "@midnite/studio-db-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Pure Node/TS database layer — Postgres/MySQL/MariaDB/MSSQL drivers behind one interface, connection pooling, schema introspection, statement sniffing. No electron imports.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@midnite/studio-shared": "workspace:*",
    "mariadb": "^3.4.0",
    "mysql2": "^3.11.5",
    "pg": "^8.13.1",
    "pg-cursor": "^2.12.0",
    "tedious": "^18.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/pg-cursor": "^2.7.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
