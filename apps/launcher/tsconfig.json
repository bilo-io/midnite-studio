{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    // esbuild bundles main + preload and Vite builds the renderer; tsc only
    // checks. Nothing project-references this package, so `composite` (from the
    // base) and the declaration outputs it requires are off — the same shape
    // packages/app and packages/website use.
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node", "vite/client"]
  },
  "include": ["src/**/*", "vite.config.ts", "vitest.config.ts"],
  "exclude": ["dist", "release", "node_modules"]
}
